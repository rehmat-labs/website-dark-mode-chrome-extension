{
  "manifest_version": 3,
  "name": "Website Dark Mode",
  "short_name": "Dark Mode",
  "version": "2.0.0",
  "author": "Rehmat Ullah",
  "homepage_url": "https://github.com/rehmat-labs/website-dark-mode-chrome-extension",
  "description": "Dark mode for any website — turn it on per site with one click, or let Auto mode darken every light website for you. Only changes colors; fonts and sizes stay the same.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Website Dark Mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png",
      "48": "icons/icon-off-48.png",
      "128": "icons/icon-off-128.png"
    }
  },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle dark mode on the current website"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
